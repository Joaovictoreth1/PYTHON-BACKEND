# Copie para .env (ou exporte as variáveis) e ajuste os valores.

# development | production. Em production a API recusa iniciar com a chave padrão.
ENVIRONMENT=development

# URL SQLAlchemy. Padrão: SQLite local.
DATABASE_URL=sqlite:///./taskflow_v2.db

# Chave exigida no header X-API-Key (mínimo 16 caracteres).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=troque-por-uma-chave-segura

# Origens CORS permitidas, separadas por vírgula. "*" libera todas (sem credentials).
CORS_ORIGINS=*

# Rate limiting por IP (janela deslizante, em memória por processo).
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
