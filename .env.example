# Copie para .env (ou exporte as variáveis) e ajuste os valores.

# development | production. Em production a API recusa iniciar com a SECRET_KEY padrão.
ENVIRONMENT=development

# URL SQLAlchemy. Padrão: SQLite local. Para Postgres: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./taskflow_v2.db

# Chave secreta para assinatura de JWT HS256 (mínimo 32 caracteres).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-secreta-com-pelo-menos-32-chars

# Expiração dos tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Origens CORS permitidas, separadas por vírgula. "*" libera todas (sem credentials).
CORS_ORIGINS=*

# Rate limiting por IP (janela deslizante). Se REDIS_URL estiver definida, usa Redis com fallback em memória.
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# REDIS_URL=redis://localhost:6379/0

# Ative atrás de reverse proxy (Nginx, Render, Railway) para ler X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Em produção com Alembic, defina false e rode `alembic upgrade head` no deploy.
AUTO_CREATE_TABLES=true

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# text | json (use json em produção para agregadores de log)
LOG_FORMAT=text
